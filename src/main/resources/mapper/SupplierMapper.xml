<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.repair.manage.module.supplier.mapper.SupplierMapper">

    <sql id="whereCondition">
        <where>
            <if test="entity.id != null">
                AND supplier.id = #{entity.id}
            </if>
            <if test="entity.supplierName != null and entity.supplierName != ''">
                AND supplier.supplier_name LIKE CONCAT('%', #{entity.supplierName}, '%')
            </if>
        </where>
    </sql>

    <!-- 分页查询 -->
    <select id="pageQuery" resultType="com.repair.manage.module.supplier.entity.Supplier">
        SELECT supplier.*
        FROM supplier supplier
        <include refid="whereCondition"/>
        ORDER BY supplier.create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 查询总数 -->
    <select id="countQuery" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM supplier supplier
        <include refid="whereCondition"/>
    </select>

    <!-- 列表查询（不分页） -->
    <select id="listQuery" resultType="com.repair.manage.module.supplier.entity.Supplier">
        SELECT supplier.*
        FROM supplier supplier
        <include refid="whereCondition"/>
        ORDER BY supplier.create_time DESC
    </select>

    <!-- 根据ID查询 -->
    <select id="getById" resultType="com.repair.manage.module.supplier.entity.Supplier">
        SELECT supplier.*
        FROM supplier supplier
        WHERE supplier.id = #{id}
    </select>

</mapper>
