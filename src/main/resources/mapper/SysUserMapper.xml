<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.repair.manage.module.sys_user.mapper.SysUserMapper">

    <sql id="whereCondition">
        <where>
            <if test="entity.id != null">
                AND sysUser.id = #{entity.id}
            </if>
            <if test="entity.username != null and entity.username != ''">
                AND sysUser.username LIKE CONCAT('%', #{entity.username}, '%')
            </if>
            <if test="entity.realName != null and entity.realName != ''">
                AND sysUser.real_name LIKE CONCAT('%', #{entity.realName}, '%')
            </if>
            <if test="entity.roleType != null">
                AND sysUser.role_type = #{entity.roleType}
            </if>
            <if test="entity.phone != null and entity.phone != ''">
                AND sysUser.phone LIKE CONCAT('%', #{entity.phone}, '%')
            </if>
            <if test="entity.status != null">
                AND sysUser.status = #{entity.status}
            </if>
        </where>
    </sql>

    <!-- 分页查询 -->
    <select id="pageQuery" resultType="com.repair.manage.module.sys_user.entity.SysUser">
        SELECT sysUser.*
        FROM sys_user sysUser
        <include refid="whereCondition"/>
        ORDER BY sysUser.create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 查询总数 -->
    <select id="countQuery" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM sys_user sysUser
        <include refid="whereCondition"/>
    </select>

    <!-- 列表查询（不分页） -->
    <select id="listQuery" resultType="com.repair.manage.module.sys_user.entity.SysUser">
        SELECT sysUser.*
        FROM sys_user sysUser
        <include refid="whereCondition"/>
        ORDER BY sysUser.create_time DESC
    </select>

    <!-- 根据ID查询 -->
    <select id="getById" resultType="com.repair.manage.module.sys_user.entity.SysUser">
        SELECT sysUser.*
        FROM sys_user sysUser
        WHERE sysUser.id = #{id}
    </select>

</mapper>
