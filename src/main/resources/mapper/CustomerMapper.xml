<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.repair.manage.module.customer.mapper.CustomerMapper">

    <sql id="whereCondition">
        <where>
            <if test="entity.id != null">
                AND customer.id = #{entity.id}
            </if>
            <if test="entity.customerName != null and entity.customerName != ''">
                AND customer.customer_name LIKE CONCAT('%', #{entity.customerName}, '%')
            </if>
            <if test="entity.phone != null and entity.phone != ''">
                AND customer.phone LIKE CONCAT('%', #{entity.phone}, '%')
            </if>
        </where>
    </sql>

    <!-- 分页查询 -->
    <select id="pageQuery" resultType="com.repair.manage.module.customer.entity.Customer">
        SELECT customer.*
        FROM customer customer
        <include refid="whereCondition"/>
        ORDER BY customer.create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 查询总数 -->
    <select id="countQuery" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM customer customer
        <include refid="whereCondition"/>
    </select>

    <!-- 列表查询（不分页） -->
    <select id="listQuery" resultType="com.repair.manage.module.customer.entity.Customer">
        SELECT customer.*
        FROM customer customer
        <include refid="whereCondition"/>
        ORDER BY customer.create_time DESC
    </select>

    <!-- 根据ID查询 -->
    <select id="getById" resultType="com.repair.manage.module.customer.entity.Customer">
        SELECT customer.*
        FROM customer customer
        WHERE customer.id = #{id}
    </select>

</mapper>
