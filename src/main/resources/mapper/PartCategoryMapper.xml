<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.repair.manage.module.part_category.mapper.PartCategoryMapper">

    <sql id="whereCondition">
        <where>
            <if test="entity.id != null">
                AND partCategory.id = #{entity.id}
            </if>
            <if test="entity.categoryName != null and entity.categoryName != ''">
                AND partCategory.category_name LIKE CONCAT('%', #{entity.categoryName}, '%')
            </if>
        </where>
    </sql>

    <!-- 分页查询 -->
    <select id="pageQuery" resultType="com.repair.manage.module.part_category.entity.PartCategory">
        SELECT partCategory.*
        FROM part_category partCategory
        <include refid="whereCondition"/>
        ORDER BY partCategory.create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 查询总数 -->
    <select id="countQuery" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM part_category partCategory
        <include refid="whereCondition"/>
    </select>

    <!-- 列表查询（不分页） -->
    <select id="listQuery" resultType="com.repair.manage.module.part_category.entity.PartCategory">
        SELECT partCategory.*
        FROM part_category partCategory
        <include refid="whereCondition"/>
        ORDER BY partCategory.create_time DESC
    </select>

    <!-- 根据ID查询 -->
    <select id="getById" resultType="com.repair.manage.module.part_category.entity.PartCategory">
        SELECT partCategory.*
        FROM part_category partCategory
        WHERE partCategory.id = #{id}
    </select>

</mapper>
